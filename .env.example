# YouTube Data API v3 key. Required for real LIVE badges.
# Create a project at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Do not use search.list as a poller. See README.
YOUTUBE_API_KEY=

# Resend — https://resend.com/api-keys
# Verify airportrunwayslive.com on Resend, then drop the key in.
# Local: put it here. Vercel/Cloudflare: set the same names in project env.
RESEND_API_KEY=
RESEND_FROM=Airport Runways Live <hello@airportrunwayslive.com>
RESEND_TO=hello@airportrunwayslive.com
