---
import { mapPoints } from '../data/locations';

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const points = mapPoints();
const cams = points.filter((p) => p.status === '247').length;
const channelCount = points.reduce((n, p) => n + p.streams.length, 0);
---
<div class:list={['map-shell', { 'map-shell-full': full }]} data-map-root>
  <div class="globe-layout">
    <div
      class="world-map"
      data-board-map
      data-full={full ? '1' : '0'}
      role="application"
      aria-label="Rotating globe of airport livestreams"
    ></div>
    <div class="globe-hud">
      <span class="globe-hud-kicker">ARL · WORLD BOARD</span>
      <strong>{points.length} airports · {channelCount} channels</strong>
      <span class="muted">{cams} always-on 24/7 cams · rest are hosted / scheduled</span>
      <span class="muted" data-sun-label></span>
    </div>
    <aside class="globe-panel" data-globe-panel hidden></aside>
  </div>
  <script type="application/json" data-map-points set:html={JSON.stringify(points)} />
</div>
<script>
  import '../scripts/board-globe.ts';
</script>
