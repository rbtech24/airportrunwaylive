---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found | Airport Runways Live" description="That page is not on the board.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Not on the board</h1>
      <p class="lede">That path is not a published page. The live directory is still up.</p>
      <div class="btn-row">
        <a class="btn btn-amber" href="/live">Live board</a>
        <a class="btn btn-ghost" href="/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
