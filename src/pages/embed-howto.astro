---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Embed the board | Airport Runways Live"
  description="Embed a live-board widget. Clicks go to official YouTube. We do not restream."
>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">Distribution</p>
      <h1>Embed the board</h1>
      <p>
        Drop this on a blog or Discord embed preview. Every row opens official YouTube. Creators keep the view.
      </p>
      <pre><code>&lt;iframe
  src="https://www.airportrunwayslive.com/embed"
  title="Airport Runways Live"
  width="360"
  height="520"
  style="border:0;border-radius:14px"
&gt;&lt;/iframe&gt;</code></pre>
      <p>
        Notify-when-live lives on YouTube, not here. Subscribe and hit the bell on
        <a href="https://www.youtube.com/@AirportRunwaysLive" target="_blank" rel="noopener noreferrer">@AirportRunwaysLive</a>.
      </p>
    </div>
  </section>
</BaseLayout>
