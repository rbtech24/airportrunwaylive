---
import BaseLayout from '../layouts/BaseLayout.astro';
import { airports } from '../data/airports';
import { creators } from '../data/catalog';

const board = [
  ['/', 'Home'],
  ['/live', 'Live board'],
  ['/map', 'Globe'],
  ['/airports', 'Airports'],
  ['/cams', '24/7 cams'],
  ['/channel', 'Our channel'],
  ['/creators', 'Creators'],
  ['/schedule', 'Schedule'],
  ['/desk', 'Aviation Live Desk'],
  ['/about', 'About'],
  ['/faq', 'FAQ'],
  ['/add', 'Add a stream'],
  ['/host-a-cam', 'Host a cam'],
  ['/contact', 'Contact'],
  ['/featured', 'Featured'],
  ['/embed-howto', 'Embed'],
];
---
<BaseLayout
  title="Sitemap | Airport Runways Live"
  description="Every public page on Airport Runways Live. XML sitemap for crawlers: /sitemap.xml."
>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">Directory</p>
      <h1>Sitemap</h1>
      <p>
        Crawlers should use the XML file:
        {' '}<a href="/sitemap.xml">sitemap.xml</a>
        ({board.length + airports.length + creators().length}+ URLs).
      </p>

      <h2>Board</h2>
      <ul>
        {board.map(([href, label]) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>

      <h2>Airports</h2>
      <ul>
        {airports.map((a) => (
          <li>
            <a href={`/airports/${a.code.toLowerCase()}`}>
              {a.code} — {a.city}
            </a>
          </li>
        ))}
      </ul>

      <h2>Creators</h2>
      <ul>
        {creators().map((c) => (
          <li>
            <a href={`/creators/${c.slug}`}>{c.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
