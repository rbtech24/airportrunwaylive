---
import BaseLayout from '../layouts/BaseLayout.astro';
import StreamCard from '../components/StreamCard.astro';
import { site } from '../data/site';
import { streams } from '../data/catalog';

const ours = streams.filter((s) => s.host);
---
<BaseLayout
  title="Our YouTube channel | Airport Runways Live"
  description="Airport Runways Live on YouTube. Hosted spotting from Orlando MCO with GOAA approval, plus Tampa and Bogotá specials."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{site.youtubeHandle}</p>
      <h1>Our channel</h1>
      <p class="lede">
        Hosted first. The weekly Aviation Live Desk is how the board and the channel feed each other.
        A 24/7 Orlando cam later, if a rooftop ever exists — an upgrade, not the business.
      </p>
      <div class="btn-row">
        <a class="btn btn-amber" href={site.youtube} target="_blank" rel="noopener noreferrer">Subscribe on YouTube</a>
        <a class="btn btn-ghost" href="/desk">Aviation Live Desk</a>
        <a class="btn btn-ghost" href={site.youtube} target="_blank" rel="noopener noreferrer">Notify me when we go live</a>
      </div>
      <p class="tiny">The bell lives on YouTube. We will not fake a push notification on this domain.</p>

      <div class="grid grid-3" style="margin-top: 28px">
        {ours.map((s) => <StreamCard stream={s} />)}
      </div>

      <div class="prose" style="margin-top: 32px">
        <h2>Who we are</h2>
        <p>
          Airport Runways Live is a hosted plane-spotting channel and a directory of other creators’ official YouTube lives.
          We stream from Orlando International (MCO) with Greater Orlando Aviation Authority spotting approval.
        </p>
        <h2>Where we stream</h2>
        <ul>
          <li><a href="/airports/mco">MCO</a> — home base, GOAA permit</li>
          <li><a href="/airports/tpa">TPA</a> — practice field for gear</li>
          <li><a href="/airports/bog">BOG</a> — specials when we are in Colombia</li>
        </ul>
        <h2>Gear philosophy</h2>
        <p>
          Hosted first, 24/7 cam later. We will not claim an Orlando camera that is not on a roof yet.
          If you have a runway view, read <a href="/host-a-cam">host a cam</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
