---
import BaseLayout from '../layouts/BaseLayout.astro';
import { creators } from '../data/catalog';

const list = creators();
---
<BaseLayout
  title="Creators | Airport Runways Live"
  description="YouTube channels listed on the Airport Runways Live board. Official links only."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Directory</p>
      <h1>Creators</h1>
      <p class="lede">Every listing is an official YouTube channel. Featured flags exist for a future paid slot — none are sold yet.</p>
      <div class="grid grid-2">
        {list.map((c) => (
          <article class="stream-card">
            <div class="channel">{c.name}</div>
            <div class="handle">{c.handle}</div>
            <p class="muted">{c.streams.map((s) => s.airport).join(' · ')}</p>
            <div class="card-actions">
              <a class="btn btn-amber" href={c.url} target="_blank" rel="noopener noreferrer">YouTube</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
