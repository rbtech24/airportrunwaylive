---
import BaseLayout from '../layouts/BaseLayout.astro';
import BoardMap from '../components/BoardMap.astro';
---
<BaseLayout
  title="Airport livestream globe | Airport Runways Live"
  description="Rotating globe of airport runway livestreams. Click a pin for the official YouTube stream at that field."
>
  <section class="section map-page">
    <div class="wrap">
      <p class="eyebrow">Board globe</p>
      <h1>Worldwide runways</h1>
      <p class="lede">
        A rotating globe with one pin per airport. Click a pin for the official YouTube lives at that field. We do not
        restream.
      </p>
    </div>
    <div class="wrap">
      <BoardMap full />
    </div>
  </section>
</BaseLayout>
